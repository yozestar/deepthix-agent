{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Deepthix Agent",
  "version": "0.1.1",
  "identifier": "dev.deepthix.agent",
  "build": {
    "frontendDist": "../dist/webview",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:webview",
    "beforeBuildCommand": "npm run build:webview"
  },
  "app": {
    "windows": [
      {
        "title": "Deepthix Agent",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
