{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Elyone AI Desktop Agent",
  "version": "0.5.8",
  "identifier": "com.elyone.desktop-agent",
  "build": {
    "frontendDist": "../dist/webview",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:webview",
    "beforeBuildCommand": "npm run build:webview"
  },
  "app": {
    "windows": [
      {
        "title": "Elyone AI Desktop Agent",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: ipc: blob: data: media:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' blob: data: tauri: ipc:; connect-src 'self' tauri: ipc: ws: wss: https://fonts.googleapis.com https://fonts.gstatic.com; frame-src 'self' blob: data:; media-src 'self' blob: data: mediastream:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {}
}
